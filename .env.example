NEXT_PUBLIC_SITE_URL=https://zaihaisurfing.com
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=replace-with-google-maps-embed-api-key

# Optional translation provider keys for future automated translation workflows.
DEEPL_API_KEY=
GOOGLE_CLOUD_TRANSLATE_API_KEY=

# ZAIHAI news monitor MVP.
OPENAI_API_KEY=
NEWS_MONITOR_DATABASE_URL=sqlite:///./news_monitor.db
NEWS_MONITOR_OPENAI_MODEL=gpt-4.1-mini
NEWS_MONITOR_MIN_SCORE=70
NEWS_MONITOR_DAILY_LIMIT=8
NEWS_MONITOR_RUN_HOUR_UTC=1

# Inquiry email API, store these only in backend/Vercel environment variables.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=davidsha@zaihaisurfing.com
SMTP_PASS=
INQUIRY_FROM=davidsha@zaihaisurfing.com
INQUIRY_TO=davidsha@zaihaisurfing.com
ALLOWED_ORIGINS=https://www.zaihaisurfing.com,https://zaihaisurfing.com

# Admin dashboard. Replace before public launch.
ADMIN_EMAIL=davidsha@zaihaisurfing.com
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Qianhai credit card gateway placeholder. Fill after acquirer provides API docs.
QIANHAI_MERCHANT_ID=
QIANHAI_GATEWAY_URL=
QIANHAI_SECRET_KEY=
