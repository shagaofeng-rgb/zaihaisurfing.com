NEXT_PUBLIC_SITE_URL=https://www.zaihaisurfing.com
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=replace-with-google-maps-embed-api-key
SITE_URL=https://www.zaihaisurfing.com
DATABASE_URL=
REVALIDATION_SECRET=
ANALYTICS_SECRET=

# Google Search Console SEO sync for /admin/seo.
# Add the service account email as a user in Google Search Console first.
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:zaihaisurfing.com
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=https://www.zaihaisurfing.com/sitemap.xml
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SYNC_DAYS=28

# Durable commerce storage for Vercel. Required for live orders, payment callbacks, and member accounts.
# Use Vercel KV or Upstash Redis REST credentials. Without this, production falls back to temporary storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
COMMERCE_STORE_PREFIX=zaihai-commerce

# Optional translation provider keys for future automated translation workflows.
DEEPL_API_KEY=
GOOGLE_CLOUD_TRANSLATE_API_KEY=

# News Autopilot. Production publishes validated News directly by default and
# never auto-publishes Blog. Set either flag to false to pause production.
NEWS_AUTOPILOT_ENABLED=
NEWS_AUTOPILOT_PUBLISH_ENABLED=
NEWS_AUTOPILOT_SOURCE_FEEDS=
NEWS_AUTOPILOT_CONTENT_MODEL=
CRON_SECRET=

# Facebook Page publisher. Set these in Vercel Production only; never expose
# them with NEXT_PUBLIC_ or commit real values. META_GRAPH_API_VERSION should
# be the current stable Graph API version selected in Meta for Developers.
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_PAGE_ID=
FACEBOOK_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
FACEBOOK_CONTENT_MODEL=

# External Blog publishing plugin. This is a server-only webhook secret; never expose it in client code.
WEBHOOK_ARTICLE_SIGN=
WEBHOOK_ARTICLE_CLASS_ID=blog
# Legacy names remain supported for a staged credential migration only.
BLOG_WEBHOOK_SIGN=
BLOG_WEBHOOK_CLASS_ID=blog

# Inquiry email API, store these only in backend/Vercel environment variables.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=davidsha@zaihaisurfing.com
SMTP_PASS=
SMTP_FROM=davidsha@zaihaisurfing.com
INQUIRY_FROM=davidsha@zaihaisurfing.com
INQUIRY_TO=davidsha@zaihaisurfing.com
ALLOWED_ORIGINS=https://www.zaihaisurfing.com,https://zaihaisurfing.com

# Admin dashboard. Replace before public launch.
ADMIN_EMAIL=davidsha@zaihaisurfing.com
ADMIN_PASSWORD=
ADMIN_DEFAULT_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=ZAIHAI Admin
ADMIN_JWT_SECRET=
SESSION_SECRET=

# Qianhai credit card gateway placeholder. Fill after acquirer provides API docs.
QIANHAI_MERCHANT_ID=
QIANHAI_GATEWAY_URL=
QIANHAI_SECRET_KEY=
QIANHAI_NOTIFY_URL=https://zaihaisurfing.com/api/payments/qianhai/notify

# Oceanpayment embedded checkout. Required for credit card, Google Pay and Apple Pay.
OCEANPAYMENT_ACCOUNT=
OCEANPAYMENT_CARD_TERMINAL=
OCEANPAYMENT_CARD_SECURE_CODE=
OCEANPAYMENT_CARD_PUBLIC_KEY=
OCEANPAYMENT_WALLET_TERMINAL=
OCEANPAYMENT_WALLET_SECURE_CODE=
OCEANPAYMENT_WALLET_PUBLIC_KEY=
# Legacy single-terminal fallback. Prefer the CARD/WALLET variables above.
OCEANPAYMENT_TERMINAL=
OCEANPAYMENT_SECURE_CODE=
OCEANPAYMENT_PUBLIC_KEY=
OCEANPAYMENT_GATEWAY_URL=https://secure.oceanpayment.com/gateway/service/test
OCEANPAYMENT_ENV=test
OCEANPAYMENT_ALLOW_NOTICE_SIMULATION=false
OCEANPAYMENT_SIMULATION_TOKEN=

# Optional international payment providers for future checkout expansion.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYMENT_CURRENCY=USD
